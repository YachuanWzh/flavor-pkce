PUBLIC_GATEWAY_URL=http://127.0.0.1:8092
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-service-token
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Migration template for the built-in testuser. New users configure their own
# route at /settings/llm.
DEFAULT_LLM_PROVIDER_ID=deepseek
DEFAULT_LLM_SERVICE_NAME=DeepSeek
DEFAULT_LLM_API_TYPE=anthropic
DEFAULT_LLM_MODEL=deepseek-v4-pro
DEFAULT_LLM_CHEAP_MODEL=deepseek-v4-flash
DEFAULT_LLM_MAX_OUTPUT_TOKENS=65536

UPSTREAM_URL=https://api.example.com/anthropic
UPSTREAM_API_KEY=replace-with-upstream-key
# x-api-key, bearer, or api-key
UPSTREAM_AUTH_TYPE=x-api-key
# 运维批准的上游 host 白名单（逗号分隔，hostname 或字面 IP），命中后跳过
# SSRF 出站校验。适用于内网/本地 LLM 端点，或 DNS 被代理 fake-ip 保留段
# （198.18.0.0/15 等）接管、域名解析不出公网地址的环境。
# 示例: UPSTREAM_URL_ALLOWLIST=api.deepseek.com,127.0.0.1
UPSTREAM_URL_ALLOWLIST=

# 成本估算单价（USD / 百万 token），供 /api/stats/cost 与仪表盘成本卡片使用。
# JSON 形状: {"模型名": {"prompt": 3.0, "completion": 15.0,
#                         "cache_read": 0.3, "cache_creation": 3.0}}
# 未配置的模型成本按 $0 计;留空则成本估算整体为 0。
# 示例:
# MODEL_PRICES_JSON={"deepseek-v4-pro":{"prompt":0.28,"completion":0.42},"gpt-5":{"prompt":1.25,"completion":10.0}}

# ---- 网关治理：每用户配额（0 = 该项不限制） ----
# 每分钟请求数（固定 1 分钟窗口，按用户）。
RATE_LIMIT_RPM=0
# 每日 token 预算（与仪表盘口径一致：prompt+completion+cache_read+
# cache_creation 合计，按 UTC 自然日）。
DAILY_TOKEN_BUDGET=0
# 每日成本预算（USD，依赖 MODEL_PRICES_JSON 计价）。
DAILY_COST_BUDGET_USD=0

# ---- 网关 JWT 密钥轮换 ----
# 网关从 auth-server 拉取 JWKS，按令牌 kid 校验轮换后的新密钥；留空则自动
# 从 AUTH_SERVER_INTERNAL_URL 推导为 {AUTH_SERVER_INTERNAL_URL}/.well-known/jwks.json。
# 无 kid 的旧令牌仍回退本地 JWT_PUBLIC_KEY 校验，升级过程兼容不中断。
JWT_JWKS_URL=
# JWKS 惰性刷新节流（秒）：遇到未知 kid 时最多每隔该时间拉取一次。
JWT_JWKS_REFETCH_SECONDS=60

# ---- 网关治理：审计数据留存 ----
# 审计数据保留天数（audit_logs / agent_queries / quota_usage），启动时清理。
AUDIT_RETENTION_DAYS=180
# 每条审计日志 request/response body 最大字符数；0 = 完全不记录 body。
AUDIT_BODY_MAX_CHARS=50000

# ---- 网关治理：异常检测 ----
# 启动扫描后的周期性重扫间隔（秒）；0 = 仅启动时扫描一次。
ALERT_SCAN_INTERVAL_SECONDS=86400
