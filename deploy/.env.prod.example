# ===== flavor-pkce 生产环境模板（P0-12）=====
# 复制为 .env.prod 并全部替换为强随机值：
#   cp deploy/.env.prod.example .env.prod
# 生成强随机值示例：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- 域名（必填）---
# Caddy 自动申请 Let's Encrypt 证书，需确保 DNS A 记录指向本机公网 IP
PUBLIC_DOMAIN=auth.example.com
PUBLIC_GATEWAY_DOMAIN=gw.example.com
# 浏览器访问 auth 的完整 Origin（用于 CORS 与 cookie）
PUBLIC_AUTH_ORIGIN=https://auth.example.com
# token 响应中告知客户端的网关地址
PUBLIC_GATEWAY_URL=https://gw.example.com

# --- 密钥（必填，全部替换）---
AUTH_SECRET_KEY=replace-with-64-char-random
INTERNAL_SERVICE_TOKEN=replace-with-64-char-random
AUDIT_API_TOKEN=replace-with-64-char-random

# --- 管理员初始账号（建议首次启动后立即修改/改用注册）---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-unique-password

# --- 默认 LLM 上游（网关出站目标，必须为公网 http(s) 地址）---
UPSTREAM_URL=https://api.example.com/anthropic
UPSTREAM_API_KEY=replace-with-upstream-key
UPSTREAM_AUTH_TYPE=x-api-key

# --- 可选调优 ---
AUDIT_RETENTION_DAYS=180
REFRESH_TOKEN_EXPIRES_IN=2592000
REVOCATION_CACHE_TTL_SECONDS=5
ROUTING_CACHE_TTL_SECONDS=0
